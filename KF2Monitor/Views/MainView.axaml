.18.62-1.48.35-2.24.51-1.51.29-2.26.4-1.52.2-2.3.28c-1.56.15-3.13.23-4.71.23-.78,0-1.57,0-2.36-.06s-1.55-.09-2.33-.17-1.55-.17-2.3-.28-1.5-.25-2.27-.4S50.71,91,50,90.84s-1.45-.39-2.17-.61-1.42-.46-2.11-.71-1.41-.54-2.1-.84l-.2-.09c-.66-.28-1.32-.58-2-.91s-1.32-.65-2-1-1.3-.72-1.93-1.11-1.3-.8-1.92-1.21-1.2-.82-1.79-1.25-1.16-.88-1.73-1.35-1.13-1-1.68-1.46-1.11-1-1.62-1.53l0,0c-.52-.51-1-1-1.51-1.57s-1-1.09-1.44-1.66-.91-1.15-1.35-1.74-.86-1.2-1.26-1.81S22.4,70.73,22,70.1l0,0H9.48A9.51,9.51,0,0,1,0,60.57V31.67a9.49,9.49,0,0,1,9.48-9.48Zm44.6,64.18c-1.17-1-2.29-2-3.37-3.06q-2-1.87-3.76-3.75c-1.27-1.36-2.47-2.72-3.58-4.08s-2.09-2.65-3-4H29.29l.36.46.78.92c.65.75,1.34,1.49,2,2.2l0,0c.46.46.93.91,1.41,1.34s1,.87,1.47,1.27,1,.81,1.53,1.2,1.06.76,1.6,1.13,1.09.71,1.67,1.06,1.13.67,1.7,1,1.2.64,1.81.92,1.22.57,1.85.84l.13.08c.61.25,1.21.49,1.82.71s1.23.43,1.87.63h0c.62.2,1.26.38,1.9.54s1.3.31,1.95.43l.86.16ZM29.24,20.75H41q1.39-2,3-3.95t3.5-4.08c1.15-1.26,2.38-2.53,3.67-3.81,1.06-1,2.17-2.1,3.31-3.15L54,5.85,53.18,6c-.64.13-1.3.28-2,.45s-1.3.35-1.93.54-1.27.42-1.91.65-1.25.48-1.86.75-1.26.56-1.86.85-1.2.59-1.79.91-1.17.65-1.74,1-1.11.69-1.64,1-1.09.74-1.61,1.13-1,.78-1.53,1.19-1,.83-1.47,1.28-1,.88-1.42,1.35l0,0c-.35.35-.7.71-1,1.07s-.68.74-1,1.11l-.78.93-.38.48ZM68.43,5.8c1.15,1,2.26,2.09,3.31,3.14,1.29,1.26,2.5,2.52,3.65,3.78s2.41,2.72,3.5,4.08,2,2.63,3,3.95H93.62l-.37-.46c-.25-.31-.51-.62-.77-.92s-.66-.74-1-1.11-.68-.72-1.06-1.09-1-.93-1.42-1.36-1-.87-1.47-1.27-1-.81-1.53-1.2-1.06-.76-1.6-1.13-1.09-.71-1.66-1.05-1.14-.67-1.72-1-1.18-.63-1.78-.91S78,8.7,77.37,8.42l-.13-.08c-.61-.25-1.22-.48-1.82-.71S74.18,7.2,73.55,7h0c-.63-.19-1.26-.37-1.9-.54s-1.3-.3-2-.43l-.83-.16-.43-.07ZM64,8.82V20.75H75.43c-.71-.9-1.45-1.8-2.23-2.7q-1.36-1.59-2.89-3.18t-3.23-3.24c-1-.93-2-1.87-3-2.81Zm0,62.67V83.64q1.68-1.41,3.26-2.85,1.78-1.64,3.41-3.27c1.07-1.09,2.09-2.17,3.05-3.26.82-.92,1.6-1.84,2.34-2.77Zm-5.2,12.15V71.49H46.78c.74.93,1.51,1.86,2.33,2.78,1,1.08,2,2.16,3,3.24s2.22,2.18,3.42,3.28c1,.95,2.14,1.9,3.27,2.85Zm0-62.89V8.82c-1.05.94-2.06,1.87-3,2.8q-1.71,1.64-3.24,3.25c-1,1.06-2,2.12-2.89,3.18q-1.17,1.35-2.22,2.7ZM9.48,26.41H113.4a5.28,5.28,0,0,1,5.26,5.26v28.9a5.28,5.28,0,0,1-5.26,5.26H9.48a5.28,5.28,0,0,1-5.26-5.26V31.67a5.28,5.28,0,0,1,5.26-5.26Z" Width="20" Height="14"/>
                                                <TextBlock Text="EXTASY.ES" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Carousel>

            <Border Grid.Row="2" Padding="20,10,20,24">
                <Button Classes="ActionBtn" Content="{Binding LocSaveBtn}" Command="{Binding SaveCommand}"/>
            </Border>
        </Grid>

        <!-- UPDATE MODAL -->
        <Grid IsVisible="{Binding IsUpdateModalOpen}" Background="#E0000000" ZIndex="200">
            <Border Background="#16181D" CornerRadius="24" BorderBrush="#33FFFFFF" BorderThickness="1" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding LocUpdateModalTitle}" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding AppVersion, StringFormat='{}v{0}'}" Foreground="#A0A0A0" FontSize="14" HorizontalAlignment="Center"/>
                    <PathIcon Data="M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z" Width="24" Height="24" Foreground="{Binding AccentBrush}"/>
                    <TextBlock Text="{Binding LatestVer, StringFormat='{}v{0}'}" Foreground="{Binding AccentBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>

                    <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" Foreground="{Binding AccentBrush}" Background="#33FFFFFF" Margin="0,8,0,0" IsVisible="{Binding IsDownloading}"/>
                    
                    <TextBlock Text="{Binding DownloadProgressText}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" IsVisible="{Binding DownloadProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Grid ColumnDefinitions="*,12,*" Margin="0,12,0,0">
                        <Button Grid.Column="0" Classes="ContactBtn" Content="{Binding LocCancelBtn}" Command="{Binding CloseUpdateModalCommand}" HorizontalAlignment="Stretch"/>
                        
                        <Button Grid.Column="2" Classes="ActionBtn" Content="{Binding LocDownloadBtn}" Command="{Binding DownloadAndInstallCommand}" IsVisible="{Binding !IsDownloadFinished}" HorizontalAlignment="Stretch" Padding="0,12"/>
                        <Button Grid.Column="2" Classes="ActionBtn" Content="{Binding LocInstallBtn}" Command="{Binding DownloadAndInstallCommand}" IsVisible="{Binding IsDownloadFinished}" HorizontalAlignment="Stretch" Padding="0,12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- WHATS NEW MODAL -->
        <Grid IsVisible="{Binding IsWhatsNewModalOpen}" Background="#C0000000" ZIndex="250">
            <Border Background="#16181D" CornerRadius="24" BorderBrush="#33FFFFFF" BorderThickness="1" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding LocUpdateVersionBlock}" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='{}v{0}'}" Foreground="{Binding AccentBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding WhatsNewChangelogList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Text}" FontSize="18" FontWeight="Black" Foreground="{Binding #RootControl.((vm:MainViewModel)DataContext).AccentBrush}" IsVisible="{Binding IsHeader}" Margin="0,8,0,6" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="Auto, *" IsVisible="{Binding IsBullet}">
                                            <Ellipse Width="5" Height="5" Fill="{Binding #RootControl.((vm:MainViewModel)DataContext).AccentBrushLighter}" Margin="6,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="20"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#A0A0A0" TextWrapping="Wrap" IsVisible="{Binding IsText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <Button Classes="ActionBtn" Content="{Binding LocDone}" Command="{Binding CloseWhatsNewModalCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- EDITOR MODAL -->
        <Grid IsVisible="{Binding IsEditorOpen}" Background="#C0000000" ZIndex="100">
            <Border Background="#16181D" CornerRadius="24" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="24,64,24,24" Padding="24">
                <StackPanel Spacing="16">
                    
                    <Grid>
                        <TextBlock Text="{Binding LocWidgetEditorTitle}" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,32,0"/>
                        <Button Command="{Binding ResetWidgetSettingsCommand}" Background="Transparent" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="{Binding LocReset}">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Foreground="{Binding AccentBrush}" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="#20FFFFFF"/>

                    <StackPanel Spacing="8" IsVisible="{Binding HasBackgroundImage}">
                        <TextBlock Text="{Binding LocBgPosition}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap"/>
                        <Slider Minimum="-500" Maximum="500" Value="{Binding ImageOffsetY}" Foreground="{Binding AccentBrush}"/>
                    </StackPanel>
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocFullSizeImage}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding FullSizeImage}" />
                    </Grid>
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocFadeBackground}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding FadeBackground}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocSwapTopBarText}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SwapTopBar}" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocSwapLR}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SwapLeftRight}" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocSwapWP}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SwapWavePlayers}" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocShowMap}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowMapBlock}" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocShowPlayers}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPlayersBlock}" />
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding LocShowWave}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowWaveBlock}" />
                    </Grid>

                    <Button Classes="ActionBtn" Content="{Binding LocDone}" Command="{Binding CloseEditorCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>