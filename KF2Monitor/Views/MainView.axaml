                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="Last.fm" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ContactBtn" Command="{Binding OpenEmailCommand}" Width="135">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <PathIcon Data="M4 4h16c1.11 0 2 .89 2 2v12c0 1.11-.89 2-2 2H4c-1.11 0-2-.89-2-2V6c0-1.11.89-2 2-2m16 4l-8 5l-8-5V6l8 5l8-5v2z" Width="16" Height="16"/>
                                                <TextBlock Text="Email" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <Button Classes="ContactBtn" Command="{Binding OpenExtasyCommand}" Width="280">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
