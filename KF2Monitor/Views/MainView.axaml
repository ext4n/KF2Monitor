                                                <TextBlock Text="GitHub" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
